{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脆脆的AI早咖啡 brief.json (one episode)",
  "type": "object",
  "required": ["issue_date", "coverage", "headline", "lede", "items", "video", "sph"],
  "properties": {
    "issue_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Publish morning (Asia/Shanghai) = output folder name"},
    "issue_no": {"type": "integer", "minimum": 1, "description": "Optional: overrides the auto number (days since channel launch + 1)"},
    "coverage": {"type": "object", "required": ["from", "to", "tz"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "tz": {"type": "string"}}},
    "headline": {"type": "string", "maxLength": 34, "description": "Day's 1–2 biggest stories, ≤26 CJK chars"},
    "lede": {"type": "string", "maxLength": 60},
    "items": {
      "type": "array", "minItems": 4, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "summary", "why", "key_stat", "heat", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "category": {"enum": ["tech", "app", "hardtech", "science", "capital", "biz", "gossip"], "description": "tech=LLM/core · app=应用/多模态/消费 · hardtech=硬科技/机器人/自动驾驶 · science=科学 · capital=资本 · biz=商业 · gossip=八卦"},
          "title": {"type": "string", "maxLength": 48},
          "summary": {"type": "string", "description": "2–3 sentences: who, when, what, key number; attribute reports (据《华尔街日报》)"},
          "why": {"type": "string"},
          "key_stat": {"type": "object", "required": ["value", "label"], "properties": {"value": {"type": "string", "maxLength": 8}, "label": {"type": "string", "maxLength": 32}}},
          "heat": {"type": "string", "description": "X engagement evidence, e.g. '@OpenAI 2.1万赞 / 465万浏览'"},
          "sources": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}}}
        }
      }
    },
    "video": {
      "type": "object",
      "required": ["cover_title", "cover_tags", "scenes"],
      "properties": {
        "voice_override": {"type": "object", "description": "Normally ABSENT: voice is locked in assets/channel.json"},
        "lede": {"type": "string", "maxLength": 30, "description": "今天主要看：A，B。（plain; no coffee flavor）"},
        "cover_title": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "maxLength": 12}},
        "cover_tags": {"type": "array", "minItems": 4, "maxItems": 5, "items": {"type": "string", "maxLength": 10}},
        "scenes": {
          "type": "array", "minItems": 6, "maxItems": 8,
          "items": {
            "type": "object", "required": ["type", "narration"],
            "properties": {
              "type": {"enum": ["title", "story", "outro"]},
              "narration": {"type": "string"},
              "item": {"type": "string"},
              "headline": {"type": "string", "maxLength": 20, "description": "≤10 CJK chars keeps it on one line (layout QA checks)"},
              "point": {"type": "string", "maxLength": 26},
              "take": {"type": "string", "maxLength": 20, "description": "On-screen 脆脆锐评 sticker"},
              "take_from": {"type": "string"},
              "segment": {"enum": ["zha"], "description": "gossip card (last story); narration 「最后说个八卦。」; on-screen stamp stays 「咖啡渣时间」"},
              "media": {
                "type": "object", "required": ["url", "page", "credit"],
                "description": "Optional official image/clip. Only from the story's official X post / official page / press kit.",
                "properties": {
                  "url": {"type": "string", "pattern": "^https?://"},
                  "page": {"type": "string", "pattern": "^https?://"},
                  "credit": {"type": "string", "maxLength": 24},
                  "type": {"enum": ["video", "image"]},
                  "start": {"type": "number", "minimum": 0},
                  "end": {"type": "number", "minimum": 0, "description": "stop the clip here and hold this frame (avoid blank end cards)"},
                  "fit": {"enum": ["cover", "contain"]}
                }
              }
            }
          }
        }
      }
    },
    "sph": {
      "type": "object", "required": ["title", "description", "hashtags"],
      "properties": {
        "title": {"type": "string", "minLength": 6, "maxLength": 16, "description": "短标题 ≤16; 视频号助手: only 《》quotes :：+？?%℃; commas→spaces"},
        "description": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
        "hashtags": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string", "pattern": "^#"}}
      }
    }
  }
}
